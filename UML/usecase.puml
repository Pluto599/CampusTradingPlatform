@startuml 用例图

actor Guest as G
actor RegisteredUser as U
actor Admin as A

rectangle "校园二手交易平台" {
  usecase "注册 / 登录" as UC1
  usecase "找回密码" as UC2
  usecase "浏览商品列表" as UC3
  usecase "搜索 / 筛选商品" as UC4
  usecase "查看商品详情" as UC5
  usecase "发布商品" as UC6
  usecase "编辑/下架/删除已发布商品" as UC7
  usecase "收藏商品" as UC8
  usecase "站内沟通 / 交换联系方式" as UC9
  usecase "查看/编辑个人资料" as UC10
  usecase "查看收藏/浏览历史/我的发布" as UC11
}

G --> UC1
G --> UC3
G --> UC4
G --> UC5

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11

A --> UC7 : 管理/处理违规内容

' 说明注释
note right of UC6
  发布商品需登录
end note

@enduml